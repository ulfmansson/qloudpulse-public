{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterName", "endpoint"],
  "properties": {
    "clusterName": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "endpoint": { "type": "string", "pattern": "^https?://.+" },
    "token": { "type": "string" },
    "existingSecret": { "type": "string" },
    "environment": { "type": "string", "minLength": 1 },
    "environmentNamespaceLabel": { "type": "string" },
    "labels": {
      "type": "object",
      "properties": {
        "pod": { "type": "array", "items": { "type": "string" } },
        "namespace": { "type": "array", "items": { "type": "string" } }
      }
    },
    "collectionInterval": { "type": "string" },
    "goMemLimit": { "type": "string" }
  }
}
