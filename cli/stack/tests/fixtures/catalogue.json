{
  "formatVersion": 1,
  "description": "What qloudpulse-stack estimate sends for each resource type (docs/adr/0123). Never served whole: the client sends the types it found to POST /api/report/public/estimates/catalogue and gets back these entries for those types; the endpoint keeps only these attributes too. A path a.b (up to four steps) takes b from the object a, or from every object in the list a. references names attributes whose value is another resource, sent as that resource's key.",
  "providers": ["aws"],
  "types": [
    {"type": "aws:ec2/instance:Instance", "label": "EC2 instance",
     "attributes": ["instanceType", "tenancy", "ebsOptimized", "creditSpecification.cpuCredits", "rootBlockDevice.volumeSize", "rootBlockDevice.volumeType", "rootBlockDevice.iops", "rootBlockDevice.throughput", "ebsBlockDevices.volumeSize", "ebsBlockDevices.volumeType", "ebsBlockDevices.iops", "ebsBlockDevices.throughput"]},
    {"type": "aws:ebs/volume:Volume", "label": "EBS volume",
     "attributes": ["size", "type", "iops", "throughput"]},
    {"type": "aws:rds/instance:Instance", "label": "RDS instance",
     "attributes": ["instanceClass", "engine", "engineVersion", "licenseModel", "multiAz", "allocatedStorage", "storageType", "iops", "storageThroughput", "backupRetentionPeriod", "performanceInsightsEnabled", "performanceInsightsRetentionPeriod"]},
    {"type": "aws:rds/cluster:Cluster", "label": "Aurora cluster",
     "attributes": ["engine", "engineVersion", "engineMode", "storageType", "backupRetentionPeriod", "serverlessv2ScalingConfiguration.minCapacity", "serverlessv2ScalingConfiguration.maxCapacity"]},
    {"type": "aws:rds/clusterInstance:ClusterInstance", "label": "Aurora instance",
     "attributes": ["instanceClass", "engine", "performanceInsightsEnabled"],
     "references": ["clusterIdentifier"]},
    {"type": "aws:elasticache/cluster:Cluster", "label": "ElastiCache cluster",
     "attributes": ["nodeType", "numCacheNodes", "engine"]},
    {"type": "aws:elasticache/replicationGroup:ReplicationGroup", "label": "ElastiCache replication group",
     "attributes": ["nodeType", "engine", "numCacheClusters", "numNodeGroups", "replicasPerNodeGroup", "multiAzEnabled"]},
    {"type": "aws:ec2/natGateway:NatGateway", "label": "NAT gateway",
     "attributes": ["connectivityType"]},
    {"type": "aws:ec2/eip:Eip", "label": "Elastic IP",
     "attributes": ["domain"]},
    {"type": "aws:lb/loadBalancer:LoadBalancer", "label": "load balancer",
     "attributes": ["loadBalancerType"]},
    {"type": "aws:alb/loadBalancer:LoadBalancer", "label": "load balancer",
     "attributes": ["loadBalancerType"]},
    {"type": "aws:eks/cluster:Cluster", "label": "EKS cluster",
     "attributes": ["version"]},
    {"type": "aws:eks/nodeGroup:NodeGroup", "label": "EKS node group",
     "attributes": ["instanceTypes", "capacityType", "diskSize", "amiType", "scalingConfig.desiredSize", "scalingConfig.minSize", "scalingConfig.maxSize"]},
    {"type": "aws:lambda/function:Function", "label": "Lambda function",
     "attributes": ["memorySize", "architectures", "ephemeralStorage.size"]},
    {"type": "aws:s3/bucket:Bucket", "label": "S3 bucket",
     "attributes": []},
    {"type": "aws:s3/bucketV2:BucketV2", "label": "S3 bucket",
     "attributes": []},
    {"type": "aws:ecs/service:Service", "label": "ECS service",
     "attributes": ["desiredCount", "launchType", "schedulingStrategy", "capacityProviderStrategies.capacityProvider"],
     "references": ["taskDefinition"]},
    {"type": "aws:ecs/taskDefinition:TaskDefinition", "label": "ECS task definition",
     "attributes": ["cpu", "memory", "requiresCompatibilities", "runtimePlatform.cpuArchitecture", "runtimePlatform.operatingSystemFamily", "ephemeralStorage.sizeInGib"]},
    {"type": "aws:dynamodb/table:Table", "label": "DynamoDB table",
     "attributes": ["billingMode", "readCapacity", "writeCapacity", "tableClass", "globalSecondaryIndexes.readCapacity", "globalSecondaryIndexes.writeCapacity"]},
    {"type": "aws:kinesis/stream:Stream", "label": "Kinesis stream",
     "attributes": ["shardCount", "streamModeDetails.streamMode"]},
    {"type": "aws:secretsmanager/secret:Secret", "label": "Secrets Manager secret",
     "attributes": ["replicas.region"]},
    {"type": "aws:kms/key:Key", "label": "KMS key",
     "attributes": []},
    {"type": "aws:kms/replicaKey:ReplicaKey", "label": "KMS replica key",
     "attributes": []},
    {"type": "aws:cloudwatch/metricAlarm:MetricAlarm", "label": "CloudWatch alarm",
     "attributes": ["period", "thresholdMetricId", "metricQueries.metric.metricName", "metricQueries.metric.period"]},
    {"type": "aws:cloudwatch/compositeAlarm:CompositeAlarm", "label": "CloudWatch composite alarm",
     "attributes": []},
    {"type": "aws:directoryservice/directory:Directory", "label": "Directory Service directory",
     "attributes": ["type", "size"]},
    {"type": "aws:route53/resolverEndpoint:ResolverEndpoint", "label": "Route 53 Resolver endpoint",
     "attributes": ["ipAddresses.subnetId"]},
    {"type": "aws:ec2transitgateway/vpcAttachment:VpcAttachment", "label": "Transit Gateway VPC attachment",
     "attributes": []},
    {"type": "aws:ec2transitgateway/peeringAttachment:PeeringAttachment", "label": "Transit Gateway peering attachment",
     "attributes": []},
    {"type": "aws:ec2transitgateway/connect:Connect", "label": "Transit Gateway Connect attachment",
     "attributes": []},
    {"type": "aws:ec2/vpnConnection:VpnConnection", "label": "Site-to-Site VPN connection",
     "attributes": ["type", "transitGatewayId"]},
    {"type": "aws:ec2/vpcEndpoint:VpcEndpoint", "label": "VPC endpoint",
     "attributes": ["vpcEndpointType", "subnetIds"]},
    {"type": "aws:ec2clientvpn/networkAssociation:NetworkAssociation", "label": "Client VPN network association",
     "attributes": []},
    {"type": "aws:elb/loadBalancer:LoadBalancer", "label": "Classic Load Balancer",
     "attributes": []},
    {"type": "aws:opensearch/domain:Domain", "label": "OpenSearch domain",
     "attributes": ["clusterConfig.instanceType", "clusterConfig.instanceCount", "clusterConfig.dedicatedMasterEnabled", "clusterConfig.dedicatedMasterType", "clusterConfig.dedicatedMasterCount", "clusterConfig.warmEnabled", "clusterConfig.warmType", "clusterConfig.warmCount", "ebsOptions.ebsEnabled", "ebsOptions.volumeSize", "ebsOptions.volumeType"]},
    {"type": "aws:msk/cluster:Cluster", "label": "MSK cluster",
     "attributes": ["numberOfBrokerNodes", "brokerNodeGroupInfo.instanceType", "brokerNodeGroupInfo.storageInfo.ebsStorageInfo.volumeSize"]},
    {"type": "aws:mq/broker:Broker", "label": "Amazon MQ broker",
     "attributes": ["engineType", "deploymentMode", "hostInstanceType"]},
    {"type": "aws:apigateway/stage:Stage", "label": "API Gateway stage",
     "attributes": ["cacheClusterEnabled", "cacheClusterSize"]},
    {"type": "aws:elasticsearch/domain:Domain", "label": "Elasticsearch domain",
     "attributes": ["clusterConfig.instanceType", "clusterConfig.instanceCount", "clusterConfig.dedicatedMasterEnabled", "clusterConfig.dedicatedMasterType", "clusterConfig.dedicatedMasterCount", "clusterConfig.warmEnabled", "clusterConfig.warmType", "clusterConfig.warmCount", "ebsOptions.ebsEnabled", "ebsOptions.volumeSize", "ebsOptions.volumeType"]}
  ]
}
